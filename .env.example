# Application Server Port
PORT=8000

# Database Connection URL
# For Docker Compose (PostgreSQL):
DATABASE_URL=postgresql://corvo:corvopass@postgres:5432/corvo_db
# For Local Development (SQLite fallback):
# DATABASE_URL=sqlite:///./corvo_procurement.db

# LLM API Key (Optional: if omitted, deterministic offline fallbacks are active)
LLM_API_KEY=

# Allowed CORS Origins
CORS_ORIGINS=*
